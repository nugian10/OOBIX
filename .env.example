# OOBIX — .env.example
# Salin ke .env dan isi. JANGAN pernah paste private key / seed phrase di chat.
# File .env tidak boleh di-commit ke GitHub.

# Alamat deployer (yang bayar gas). Private key-nya HANYA di .env lokal.
DEPLOYER_PRIVATE_KEY=

# Owner kontrak — DIKONFIRMASI Nugraha 20:30 WIB 30 Okt 2026.
# My Wallet (sama seperti Mythora/MythRealm/MINTFORM).
# Deploy-nya tetap ditandatangani wallet deployer terpisah yang terdanai
# (Agentic Wallet tidak punya key yang bisa diekspor, tidak bisa jadi deployer Hardhat).
OWNER_ADDRESS=0x0262e8e5E4584D8AB840fD950a6E2E0A414d4097

# Revenue wallet — penerima hasil mint. DIKONFIRMASI 20:30 WIB 30 Okt 2026.
# Binance Agentic Wallet. Pembayaran mint LANGSUNG ke sini di dalam mint()
# (diputuskan 20:33 WIB 30 Okt) — tidak masuk kontrak dulu; withdraw()
# hanya safety valve untuk dana yang masuk di luar mint().
REVENUE_WALLET=0x89c37649Ba3BAA9E1ce028612b7DE4e9c3a947B7

# Agent ID registry — SPACE ID .ai NFT (publik, dipakai WEDO/Nomio/AnthroBit/Spoxy).
# Diverifikasi on-chain 30 Okt 2026 untuk WEDO: kontrak WEDO ada (7.487 byte).
# Jangan ganti kecuali SPACE ID migrasi.
AGENT_ID_REGISTRY=0x60B9262456dE011F7d15a54CdD8c48bAaa8B022F

# Folder metadata. HARUS diakhiri '/'. tokenURI = BASE_URI + tokenId + ".json" (1.json .. 3333.json)
# Penyimpanan GitHub (diputuskan Nugraha 20:25 WIB 30 Okt, BUKAN IPFS).
# Repo publik nugian10/OOBIX SUDAH ADA dan koleksi sudah di-push (20:47 WIB 30 Okt);
# URL di bawah ini sudah aktif (raw URLs terverifikasi 200).
BASE_URI=https://raw.githubusercontent.com/nugian10/OOBIX/main/collection/metadata/

# RPC + BscScan (opsional; default di hardhat.config.js sudah ada)
BSC_RPC=https://bsc-dataseed.binance.org/
BSCSCAN_API_KEY=
